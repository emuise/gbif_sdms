library(arrow)
library(tidyverse)
library(terra)
library(tidyterra)
library(sf)
library(bcmaps)
library(gbm3)
library(maxnet)
library(viridis)
library(taxize)
muiselib2::muiselib_setup()

# set paths and mkdir

covariate_path <- here::here("data", "covariates")
clean_dir <- here::here("data", "gbif_noram")
cellcount_dir <- here::here("data", "cellcounts")
fs::dir_create(cellcount_dir)

species_list <- here::here("data", "bc_species", "species_list.rds") %>%
  read_rds()

taxa_join <- here::here("data", "spatial_counts") %>%
  arrow::open_dataset() %>%
  distinct(kingdom, phylum, class, order, family, genus, species) %>%
  collect()

c_files <- fs::dir_ls(clean_dir, recurse = TRUE, type = "file")

bcb <- bcmaps::bc_bound_hres() %>%
  vect()

# this is downloaded in 00
# i have double checked that all climate layers use the same mask
bioclim_fold <- here::here(covariate_path, "Normal_1991_2020_bioclim")

snap <- bioclim_fold %>%
  fs::dir_ls(type = "file") %>%
  head(1) %>%
  rast()

snap_vals <- terra::values(snap)[, 1]

# keep birds since 1990, keep all other observations since 1970

walk(seq_along(c_files), \(n) {
  x <- c_files[[n]]
  savename <- here::here(cellcount_dir, basename(x))
  if (file.exists(savename)) {
    return()
  }

  message(glue::glue("[{n}/{length(c_files)}]: {basename(x)}"))

  df <- open_dataset(x) %>%
    filter(
      (class == "Aves" & year >= 1990) |
        ((is.na(class) | class != "Aves") & year >= 1970)
    ) %>%
    select(species, decimallatitude, decimallongitude) %>%
    collect()

  if (nrow(df) == 0) {
    # probably should save an empty file
    return()
  }

  pts <- terra::vect(
    df,
    geom = c("decimallongitude", "decimallatitude"),
    crs = "epsg:4326"
  ) %>%
    project(snap)

  df$cell <- terra::cellFromXY(snap, terra::crds(pts))

  cc <- df %>%
    filter(!is.na(cell)) %>% # this removes anything outside the raster bounds
    mutate(snap_val = snap_vals[cell]) %>%
    filter(!is.na(snap_val)) %>% # this only keeps values that have matching climate values
    select(-snap_val) %>%
    count(species, cell, name = "n") %>%
    arrow::write_parquet(savename)
})
# 35 and 1494 evidently have nothing in them
# 35 is all birds prior to 1982
# 1494 is some plants prior to 1940

cc <- arrow::open_dataset(cellcount_dir)

cellcounts <- cc %>%
  group_by(species, cell) %>%
  summarise(n = sum(n))

# define the species list first so it is quicker, example mammals
# sampling intensities for all species, and specific groups

# functions to transform a species list into intensity values, 
# saving interim rasters
calc_group_intensity <- function(spec_list) {
  message("calculating group intensity")
  cc %>%
    filter(species %in% spec_list) %>%
    group_by(cell) %>%
    summarize(n = sum(n))
}

intensity_to_raster <- function(intensity_df) {
  message("rasterizing")
  r <- snap
  values(r) <- NA
  r[!is.nan(snap_vals)] <- 0
  r[intensity_df$cell] <- intensity_df$n

  r
}

smooth_intensity <- function(intensity_r, w = 31) {
  message("smoothing")
  focal(
    intensity_r,
    w = w,
    fun = "mean",
    na.rm = T,
    na.policy = "omit"
  )
}

pipe_save_raster <- function(
  r,
  path
) {
  names(r) <- path %>% basename() %>% tools::file_path_sans_ext()
  writeRaster(r, path, overwrite = TRUE)

  r
}

calc_smooth_intensity <- function(
  spec_list,
  name,
  w = 31,
  dir = here::here(covariate_path, "sample_intensity")
) {
  message("--- ", name, " ---")

  fs::dir_create(dir)

  raw_path <- here::here(dir, glue::glue("{name}-raw.tif"))
  smooth_path <- here::here(dir, glue::glue("{name}-smooth_{w}.tif"))
  smooth_l1p_path <- here::here(dir, glue::glue("{name}-smooth_{w}-l1p.tif"))

  if (all(file.exists(raw_path, smooth_path, smooth_l1p_path))) {
    message(glue::glue("{name}_w-{w} already processed"))
    return(rast(smooth_l1p_path))
  }

  calc_group_intensity(spec_list) %>%
    collect() %>%
    intensity_to_raster() %>%
    pipe_save_raster(raw_path) %>%
    smooth_intensity(w = w) %>%
    pipe_save_raster(smooth_path) %>%
    log1p() %>%
    pipe_save_raster(smooth_l1p_path)
}

all_species <- taxa_join %>%
  pull(species)

mammals <- taxa_join %>%
  filter(class == "Mammalia") %>%
  pull(species)

birds <- taxa_join %>%
  filter(class == "Aves") %>%
  pull(species)

plants <- taxa_join %>%
  filter(kingdom == "Plantae") %>%
  pull(species)

herps <- taxa_join %>%
  filter(
    class == "Reptilia" |
      class == "Amphibia"
  ) %>%
  pull(species)

butterflies <- taxa_join %>%
  filter(order == "Lepidoptera") %>%
  pull(species)

iter_groups <- list(
  "all_species" = all_species,
  "mammals" = mammals,
  "birds" = birds,
  "plants" = plants,
  "reptiles_amphibians" = herps,
  "butterflies" = butterflies
)

imap(iter_groups, \(spp, name) {
  calc_smooth_intensity(spp, name)
})



lc_files <- here::here(covariate_path, "landcover") %>%
  fs::dir_ls() 

lc_names <- basename(lc_files) %>%
  tools::file_path_sans_ext() %>%
  str_remove("lc_")

lc <- lc_files %>%
  rast()

names(lc) <- lc_names

grassland <- subset(lc, names(lc) %>% str_detect("grassland")) %>% sum()
names(grassland) = "grassland"
shrubland <- subset(lc, names(lc) %>% str_detect("shrubland")) %>% sum()
names(shrubland) = "shrubland"
unveg <- subset(lc, names(lc) %>% str_detect("barren|snow|taiga|urban|water")) %>% sum()
names(unveg) = "unvegetated"
evergreen <- subset(lc, c("frac_evergreen", "frac_conifers")) %>% sum()
names(evergreen) = "evergreen"
cropland <- lc$frac_cropland
names(cropland) = "cropland"
deciduous <- lc$frac_deciduous
names(deciduous) = "deciduous"
mixed <- lc$frac_mixed
names(mixed) = "mixed"
tropical <- lc$frac_tropical
names(tropical) = "tropical"

map(list(grassland, shrubland, unveg, evergreen, cropland, deciduous, mixed, tropical), \(x){
  print(names(x))
  savename <- here::here(covariate_path, "landcover_input", glue::glue("{names(x)}.tif"))
  fs::dir_create(dirname(savename))
  writeRaster(x, savename)
})


